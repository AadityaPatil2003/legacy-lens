//NIGHTINT JOB (ACCT01),'NIGHTLY INTEREST',CLASS=A,MSGCLASS=X,
//             NOTIFY=&SYSUID
//*--------------------------------------------------------------------
//* NIGHTINT - NIGHTLY INTEREST RUN (SYNTHETIC SAMPLE FOR LEGACYLENS)
//* STEP010 BACKS UP THE MASTER, STEP020 RUNS INTCALC VIA PROC,
//* STEP030 SORTS THE EXCEPTION REPORT.
//*--------------------------------------------------------------------
//STEP010  EXEC PGM=IEBGENER
//SYSUT1   DD DSN=PROD.CUST.MASTER,DISP=SHR
//SYSUT2   DD DSN=PROD.CUST.MASTER.BACKUP(+1),
//            DISP=(NEW,CATLG,DELETE),SPACE=(CYL,(10,5))
//SYSPRINT DD SYSOUT=*
//SYSIN    DD DUMMY
//*
//STEP020  EXEC INTPROC,ENV=PROD,RUNDATE=&LYYMMDD
//*
//STEP030  EXEC PGM=SORT,COND=(4,LT)
//SORTIN   DD DSN=PROD.INT.EXCEPTIONS,DISP=SHR
//SORTOUT  DD DSN=PROD.INT.EXCEPTIONS.SORTED,
//            DISP=(NEW,CATLG,DELETE)
//SYSOUT   DD SYSOUT=*
//SYSIN    DD *
  SORT FIELDS=(13,8,CH,A)
/*
